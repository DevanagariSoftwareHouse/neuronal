%% Mean firing rate per neuron and trial
trial_hist = cell(1, numel(catalog.data));

for s = 1:numel(catalog.data)
    data = catalog.data(s);

    spiketime = neuronal_memmap(files_spike(s));
    cluster   = neuronal_memmap(files_cluster(s));

    spike_time    = double(spiketime.Data.x(:));
    spike_cluster = cluster.Data.x(:);
    cluster_id    = data.brain_areas.cluster_id(:);
    brain_area    = data.brain_areas.brain_area(:);

    assert(numel(spike_time) == numel(spike_cluster), ...
        'Spike timestamps and cluster labels must have equal lengths.');

    trial_start = double([data.behavior.trials.trial_start]');
    trial_end   = double([data.behavior.trials.trial_end]');

    valid = isfinite(trial_start) & isfinite(trial_end) & ...
            trial_end > trial_start;

    trial_index = find(valid);
    trial_start = trial_start(valid);
    trial_end   = trial_end(valid);
    duration    = trial_end - trial_start;

    n_neurons = numel(cluster_id);
    n_trials  = numel(duration);
    counts    = zeros(n_neurons, n_trials);

    if n_trials > 0
        % Unique boundaries support gaps and overlapping trials.
        [edges, ~, boundary_index] = unique([trial_start; trial_end]);

        start_index = boundary_index(1:n_trials);
        end_index   = boundary_index(n_trials + 1:end);

        for c = 1:n_neurons
            t = spike_time(spike_cluster == cluster_id(c));

            % Enforce [start, end), including at the final boundary.
            t = t(isfinite(t) & t >= edges(1) & t < edges(end));

            bin_counts = histcounts(t, edges);
            cumulative = [0, cumsum(bin_counts)];

            counts(c, :) = reshape( ...
                cumulative(end_index) - cumulative(start_index), 1, []);
        end
    end

    trial_hist{s} = struct( ...
        'animal',         s, ...
        'cluster_id',     cluster_id, ...
        'brain_area',     brain_area, ...
        'trial_index',    trial_index, ...
        'trial_start',    trial_start, ...
        'trial_end',      trial_end, ...
        'trial_duration', duration, ...
        'spike_count',    counts, ...
        'trial_neuron',   counts ./ duration');
end
